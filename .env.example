# ScopeGate — environment variable reference (names only, never values).
# Everything is optional unless noted; sensible defaults apply.
# Copy what you need to your environment — do NOT commit a filled .env.

# ───────────────────────────── Core ─────────────────────────────
# Base directory for vault, identity, config, policies and audit
# (default: ~/.scopegate; containers use /data).
SCOPEGATE_HOME=

# Log verbosity: set to "debug" for stack traces and gateway debug logs.
SCOPEGATE_LOG_LEVEL=

# Agent identity used for policy decisions and audit attribution
# (set per harness entry; production ecosystem identity: nexgen-kimi).
SCOPEGATE_AGENT_ID=

# Upstream connect timeout in milliseconds (default: 10000).
SCOPEGATE_CONNECT_TIMEOUT_MS=

# "1" restores legacy behavior: spawned stdio upstreams inherit the full
# parent env. Default (unset): children get a secret-scrubbed env.
SCOPEGATE_ENV_PASSTHROUGH=

# Cross-upstream write taint tracking: "alert" (default) | "enforce".
SCOPEGATE_TAINT_MODE=

# Canary credential response mode: "enforce" (default) | "alert".
SCOPEGATE_HONEYTOKEN_MODE=

# Project directory override for harness detection (default: cwd).
SCOPEGATE_PROJECT_DIR=

# ───────────────────────────── Vault ────────────────────────────
# Vault access mode: "auto" (default) | "local" | "daemon".
SCOPEGATE_VAULT_MODE=

# Override the vaultd IPC socket / Windows named pipe path.
SCOPEGATE_VAULT_SOCKET=

# Master key backend: "auto" | "file" | "dpapi" (Windows) | "keychain"
# (macOS) | "secret-service" (Linux).
SCOPEGATE_MASTER_KEY_BACKEND=

# ─────────────────── HTTP transport & approvals ─────────────────
# Bearer token — REQUIRED when running `scopegate start --http`
# (every request except public GET /health).
SCOPEGATE_HTTP_TOKEN=

# Bearer credential for the gateway's /admin/* surface (human consoles).
SCOPEGATE_ADMIN_TOKEN=

# Lets `approve` / `deny` / `policies accept|reject` run non-interactively.
# Keep it out of the agent's reach.
SCOPEGATE_APPROVAL_TOKEN=

# ─────────────────────────── Registry ───────────────────────────
# Local registry directory override (takes precedence over URL/bundled).
SCOPEGATE_REGISTRY_PATH=

# Remote registry URL override (used when PATH is unset).
SCOPEGATE_REGISTRY_URL=

# ────────────────────── ScopeGate Cloud ─────────────────────────
# Port fallback for `scopegate cloud serve` (flag --port wins).
PORT=

# Admin bearer for the /v1/admin/* API and the panel.
# Preferred: SCOPEGATE_CLOUD_ADMIN_TOKEN. ADMIN_TOKEN is the legacy alias.
SCOPEGATE_CLOUD_ADMIN_TOKEN=
ADMIN_TOKEN=

# Postgres DSN — when set, the cloud uses PostgresStore instead of the
# default FileStore (metadata only; secret values never cross the cloud).
SCOPEGATE_CLOUD_DATABASE_URL=

# Server-side audit retention in days (default: 90).
# AUDIT_RETENTION_DAYS is the legacy alias.
SCOPEGATE_CLOUD_AUDIT_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# Gateway-side loop intervals in milliseconds (defaults: sync 60000,
# revocation 15000, approval 15000).
SCOPEGATE_CLOUD_SYNC_INTERVAL_MS=
SCOPEGATE_CLOUD_AUDIT_INTERVAL_MS=
SCOPEGATE_CLOUD_REVOCATION_INTERVAL_MS=
SCOPEGATE_CLOUD_APPROVAL_INTERVAL_MS=

# ─────────────── Deployment bootstrap (Railway/Docker) ──────────
# "1" seeds a clearly-marked fake demo upstream + fake secret on an empty
# home — self-contained demo, zero real credentials.
SCOPEGATE_SEED_DEMO=

# Base64 JSON bundle deposited into the vault at first boot (keep-first)
# by docker/bootstrap-prod.mjs. Remove from service variables after boot.
SCOPEGATE_BOOTSTRAP_SECRETS=

# ────────────────────────── Telemetry ───────────────────────────
# "1" opts in to anonymous telemetry (default: OFF — nothing is sent).
SCOPEGATE_TELEMETRY=

# Override the telemetry collector URL (self-hosting).
SCOPEGATE_TELEMETRY_ENDPOINT=

# ────────────────────── Harness adapters ────────────────────────
# Kimi Code user config dir override (harness detection migrates
# $KIMI_CODE_HOME/mcp.json behind the gateway).
KIMI_CODE_HOME=

# ───────────── Bridge mocks & API overrides (dev/test) ──────────
# "1" runs the bridge against its built-in mock (no real credentials).
HULY_CLIENT_MOCK=
RAILWAY_MOCK=
CLOUDFLARE_MOCK=
GOOGLE_MOCK=

# API URL overrides for the bridges (defaults: backboard.railway.com,
# api.cloudflare.com, googleapis.com).
RAILWAY_API_URL=
CLOUDFLARE_API_URL=
GOOGLE_API_URL=

# Huly instance URL used by the minter for account-service discovery
# (/config.json → ACCOUNTS_URL; default https://huly2.nexgen.systems).
HULY_URL=

# NOTE: HULY_TOKEN / HULY_ENDPOINT / HULY_WORKSPACE are minted by the
# gateway and injected into the huly bridge env — never set them manually.

# ──────────────────── Production e2e (CI skips) ─────────────────
# Target gateway URL for e2e-prod.mjs / e2e-ecosystem-prod.mjs
# (requires SCOPEGATE_HTTP_TOKEN of that deployment).
SCOPEGATE_PROD_URL=
